# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_education"

# Backend
PORT=3000
FRONTEND_URL="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-local-development-secret"
JWT_REFRESH_SECRET="replace-with-a-different-local-development-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI analysis (required only when the LLM adapter is enabled)
# Google Gemini is accessed through its OpenAI-compatible API from the backend.
# Keep the API key server-side; never expose it through VITE_* variables.
AI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemma-4-26b-a4b-it"
AI_API_KEY=""

# Frontend
VITE_API_URL="http://localhost:3000"

# Optional: enable only when image upload is implemented
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
