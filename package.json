{
  "name": "ai-education-platform",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered education platform MVP",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "format": "npm run format:backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "format:backend": "npm --prefix backend run format",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:reset": "npm --prefix backend run db:reset",
    "db:seed": "npm --prefix backend run db:seed",
    "db:seed:accounts": "npm --prefix backend run db:seed:accounts"
  }
}
